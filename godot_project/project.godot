config_version=5

[application]

config/name="РђСЂС…С–С‚РµРєС‚РѕСЂ РјС–СЃС–С—"
config/description="2D РіСЂР° Р· РґРёР·Р°Р№РЅСѓ РєРѕСЃРјС–С‡РЅРёС… РјС–СЃС–Р№ РЅР° СЂСѓС€С–С— Godot"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.04, 0.06, 0.09, 1)
boot_splash/image="res://assets/images/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

ThemeManager="*res://scripts/ThemeManager.gd"
DataManager="*res://scripts/DataManager.gd"
Calc="*res://scripts/Calc.gd"
GameState="*res://scripts/GameState.gd"
SoundManager="*res://scripts/SoundManager.gd"
LeaderboardManager="*res://scripts/LeaderboardManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true
window/handheld/orientation=5

[gui]

common/default_scroll_deadzone=12
common/snap_controls_to_pixels=true
theme/default_font_antialiasing=1
theme/default_font_hinting=2
theme/default_font_subpixel_positioning=0
theme/default_font_multichannel_signed_distance_field=false
theme/default_font_generate_mipmaps=false

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.06, 0.08, 0.12, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
